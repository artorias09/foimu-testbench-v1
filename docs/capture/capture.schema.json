{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "capture",
  "type": "object",
  "required": [
    "capture_id",
    "schema_version",
    "received_at",
    "source",
    "sha256",
    "size_bytes",
    "firmware_version",
    "firmware_hash",
    "hardware_revision",
    "transport",
    "baud",
    "converter",
    "duration_expected",
    "physical_condition",
    "orientation",
    "operator",
    "notes",
    "authorization_scope"
  ],
  "properties": {
    "capture_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 1
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "firmware_version": {
      "type": "string",
      "minLength": 1
    },
    "firmware_hash": {
      "type": "string",
      "minLength": 1
    },
    "hardware_revision": {
      "type": "string",
      "minLength": 1
    },
    "transport": {
      "type": "string",
      "minLength": 1
    },
    "baud": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "const": "unknown"
        }
      ]
    },
    "converter": {
      "type": "string",
      "minLength": 1
    },
    "duration_expected": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "const": "unknown"
        }
      ]
    },
    "physical_condition": {
      "type": "string",
      "minLength": 1
    },
    "orientation": {
      "type": "string",
      "minLength": 1
    },
    "operator": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "authorization_scope": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
